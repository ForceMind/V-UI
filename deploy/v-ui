#!/bin/sh
# Fixed root-owned entry point. Existing administrator sudo policy only.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
if [ "$(id -u)" -ne 0 ]; then
    exec sudo -- /usr/local/sbin/v-ui "$@"
fi
exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/ LANG=C LC_ALL=C /usr/bin/python3 -B -I -S /usr/local/lib/v-ui/system_ops.py "$@"
