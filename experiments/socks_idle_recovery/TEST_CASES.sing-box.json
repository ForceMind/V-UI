{
  "groups": [
    {
      "label": "box_owner_adapter",
      "package": "sing-box",
      "go_package": "github.com/sagernet/sing-box/adapter",
      "regex": "^TestOwner",
      "leaves": [
        "TestOwnerLeaseAbortFinalizeOnce",
        "TestOwnerPolicyCopiedValue"
