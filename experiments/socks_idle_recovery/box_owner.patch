new file mode 100644
index 0000000..9966584
--- /dev/null
+++ b/adapter/packet_session.go
@@ -0,0 +1,86 @@
+package adapter
+
+import (
+	"context"
+	"net"
+	"sync"
+
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// PacketSessionPolicy is an experimental, per-generation value. It is never
+// inherited by unmarked routes, and does not authorize outbound substitution.
+type PacketSessionPolicy struct {
+	Outbound string
+	Target M.Socksaddr
+	Lifecycle N.PacketSessionLifecycle
+}
+
+type packetSessionPolicyKey struct{}
+
+func WithPacketSessionPolicy(ctx context.Context, policy PacketSessionPolicy) context.Context {
+	return context.WithValue(ctx, packetSessionPolicyKey{}, policy)
+}
+
+func PacketSessionPolicyFromContext(ctx context.Context) (PacketSessionPolicy, bool) {
+	policy, loaded := ctx.Value(packetSessionPolicyKey{}).(PacketSessionPolicy)
+	return policy, loaded
+}
+
+// OwnedPacketSessionDialer only admits private, abortable transports. Ordinary
+// ListenPacket implementations cannot satisfy this capability by delegation.
+type OwnedPacketSessionDialer interface {
+	ValidatePacketSession() error
+	OpenPacketSession(context.Context, M.Socksaddr, func(func() error) error) (*PacketSessionLease, error)
+}
+
+// PacketSessionOnceConn prevents a second tracked Close during protocol cleanup.
+// Its net.Conn embedding deliberately exposes no optional unwrap/fast-path API.
+type PacketSessionOnceConn struct {
+	net.Conn
+	once sync.Once
+	err error
+}
+
+func (c *PacketSessionOnceConn) Close() error {
+	c.once.Do(func() { c.err = c.Conn.Close() })
+	return c.err
+}
+
+type PacketSessionLease struct {
+	packet N.PacketConn
+	abort func() error
+	cacheAfterJoin func()
+	abortOnce sync.Once
+	finalizeOnce sync.Once
+	abortErr error
+	finalizeErr error
+}
+
+func NewPacketSessionLease(packet N.PacketConn, abort func() error, cacheAfterJoin func()) *PacketSessionLease {
+	return &PacketSessionLease{packet: packet, abort: abort, cacheAfterJoin: cacheAfterJoin}
+}
+
+func (l *PacketSessionLease) PacketConn() N.PacketConn { return l.packet }
+
+func (l *PacketSessionLease) IsValid() bool { return l != nil && l.packet != nil && l.abort != nil }
+
+func (l *PacketSessionLease) AbortTransport() error {
+	l.abortOnce.Do(func() {
+		if l.abort == nil { l.abortErr = N.ErrPacketSessionLifecycle; return }
+		l.abortErr = l.abort()
+	})
+	return l.abortErr
+}
+
+// Finalize must be called only after all packet reads and writes have joined.
+func (l *PacketSessionLease) Finalize() error {
+	l.finalizeOnce.Do(func() {
+		l.AbortTransport()
+		if l.packet == nil { l.finalizeErr = N.ErrPacketSessionLifecycle } else { l.finalizeErr = l.packet.Close() }
+		if l.abort == nil { l.finalizeErr = N.ErrPacketSessionLifecycle }
+		if l.cacheAfterJoin != nil { l.cacheAfterJoin() }
+	})
+	return l.finalizeErr
+}
