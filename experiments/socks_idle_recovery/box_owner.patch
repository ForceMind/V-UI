+		OwnerID uint64 `json:"owner_id"`
+		Sequence uint64 `json:"sequence"`
+		Transition string `json:"transition"`
+		Generation uint64 `json:"generation"`
+		PacketSequence uint64 `json:"packet_sequence"`
+		AcceptedPackets uint64 `json:"accepted_packets"`
+		RejectedSources uint64 `json:"rejected_sources"`
+		RemappedPackets uint64 `json:"remapped_packets"`
+		Cause string `json:"cause"`
+		Source string `json:"source"`
+		Relay string `json:"relay"`
+		Target string `json:"target"`
+	}{os.Getpid(), ownerID, event.Sequence, event.Transition, event.Generation, event.PacketSequence,
+		event.AcceptedPackets, event.RejectedSources, event.RemappedPackets, event.Cause,
+		event.Source.String(), event.Relay.String(), event.Target.String()}
+	encoded, err := json.Marshal(record)
+	if err == nil { h.logger.InfoContext(ctx, "socks_udp_owner ", string(encoded)) }
+}
