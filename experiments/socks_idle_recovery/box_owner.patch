+	N "github.com/sagernet/sing/common/network"
+)
+
+func validatePacketSessionMetadata(policy adapter.PacketSessionPolicy, metadata *adapter.InboundContext) error {
+	if policy.Lifecycle == nil || policy.Outbound == "" || !policy.Target.IsIPv4() || policy.Target.Port == 0 || policy.Target.IsDomain() ||
+		metadata.InboundType != C.TypeMixed || metadata.Destination != policy.Target || metadata.InboundDetour != "" || metadata.FakeIP || metadata.Domain != "" || metadata.Protocol != "" ||
+		metadata.RouteOriginalDestination.IsValid() || len(metadata.DestinationAddresses) != 0 || metadata.UDPConnect ||
+		metadata.UDPTimeout != 0 || metadata.UDPDisableDomainUnmapping || metadata.NetworkStrategy != nil ||
+		len(metadata.NetworkType) != 0 || len(metadata.FallbackNetworkType) != 0 || metadata.FallbackDelay != 0 ||
+		metadata.TLSFragment || metadata.TLSFragmentFallbackDelay != 0 || metadata.TLSRecordFragment || metadata.TLSSpoof != "" || metadata.TLSSpoofMethod != 0 {
+		return E.New("unsupported packet session route metadata")
+	}
+	return nil
+}
+
+func validatePacketSessionAction(action adapter.RuleAction) error {
+	var options *R.RuleActionRouteOptions
+	switch action := action.(type) {
+	case *R.RuleActionReject:
+		return nil
+	case *R.RuleActionRoute:
+		options = &action.RuleActionRouteOptions
+	case *R.RuleActionRouteOptions:
+		options = action
