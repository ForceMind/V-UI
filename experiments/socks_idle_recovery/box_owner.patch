@@ -0,0 +1,99 @@
+package dialer
+
+import (
+	"context"
+	stdtls "crypto/tls"
+	"net"
+	"reflect"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/tls"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/bufio"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+func PacketSessionDialOptionsSupported(o option.DialerOptions) bool {
+	return o.Detour == "" && o.DomainResolver == nil && o.DomainStrategy == 0 &&
+		!o.TCPFastOpen && !o.TCPMultiPath && o.NetNs == "" &&
+		o.NetworkStrategy == nil && len(o.NetworkType) == 0 &&
+		len(o.FallbackNetworkType) == 0 && o.FallbackDelay == 0
+}
+
+func PacketSessionTLSOptionsSupported(o *option.OutboundTLSOptions) bool {
+	return o != nil && o.Enabled && !o.Insecure && !o.DisableSNI &&
+		(o.Engine == "" || o.Engine == "go") && o.UTLS == nil && o.Reality == nil && o.ECH == nil &&
+		!o.KernelTx && !o.KernelRx && !o.Fragment && !o.RecordFragment && o.FragmentFallbackDelay == 0 &&
+		o.Spoof == "" && o.SpoofMethod == "" && len(o.CertificatePublicKeySHA256) == 0
+}
+
+func packetSessionConcrete(value any, name string) bool {
+	t := reflect.TypeOf(value)
+	return t != nil && t.Kind() == reflect.Pointer && t.Elem().PkgPath() == "github.com/sagernet/sing-box/route" && t.Elem().Name() == name
+}
+
+func ValidatePacketSessionDialer(value N.Dialer, address M.Socksaddr) error {
+	d, ok := value.(*DefaultDialer)
+	if !ok || !address.IsIPv4() || address.Port == 0 || address.IsDomain() {
+		return E.New("packet session requires a direct literal IPv4 upstream")
+	}
+	if !d.dialer4.DisableTFO || d.dialer4.Dialer.MultipathTCP() || d.netns != "" ||
+		d.networkStrategy != nil || d.defaultNetworkStrategy || len(d.networkType) != 0 ||
+		len(d.fallbackNetworkType) != 0 || d.networkFallbackDelay != 0 {
+		return E.New("unsupported effective packet session dial policy")
+	}
+	if d.connectionManager != nil && !packetSessionConcrete(d.connectionManager, "ConnectionManager") {
+		return E.New("unknown packet session connection manager")
+	}
+	return nil
+}
+
+func ValidatePacketSessionTLS(config tls.Config) error {
+	standard, ok := config.(*tls.STDClientConfig)
+	if !ok { return E.New("packet session requires standard verified Go TLS") }
+	inner, err := standard.STDConfig()
+	if err != nil { return err }
+	if inner == nil || inner.InsecureSkipVerify || inner.ServerName == "" || len(inner.EncryptedClientHelloConfigList) != 0 {
+		return E.New("packet session requires standard verified Go TLS")
+	}
+	return nil
+}
+
+// DialPacketSessionTLS registers the actual private transport before TLS and
+// before any synchronous outer protocol constructor write. The owner supervisor
+// supplies a real abort timer; a context deadline alone cannot interrupt Write.
+func DialPacketSessionTLS(ctx context.Context, value N.Dialer, address M.Socksaddr, config tls.Config, attach func(func() error) error) (net.Conn, func() error, error) {
+	if err := ValidatePacketSessionDialer(value, address); err != nil { return nil, nil, err }
+	if err := ValidatePacketSessionTLS(config); err != nil { return nil, nil, err }
+	d := value.(*DefaultDialer)
+	raw, err := d.dialer4.Dialer.DialContext(ctx, "tcp4", address.String())
+	if err != nil { return nil, nil, err }
+	if _, ok := raw.(*net.TCPConn); !ok { raw.Close(); return nil, nil, E.New("non-TCP private transport") }
+	tracked, err := d.trackConn(ctx, address, raw, nil)
+	if err != nil { raw.Close(); return nil, nil, err }
+	// Prove only the exact wrappers made by trackConn, never arbitrary Upstream.
+	proof := tracked
+	if counter, ok := proof.(*bufio.CounterConn); ok {
+		wrapper, ok := counter.ExtendedConn.(*bufio.ExtendedConnWrapper)
+		if !ok { tracked.Close(); return nil, nil, E.New("unknown counter transport") }
+		proof = wrapper.Conn
+	}
+	if proof != raw && !packetSessionConcrete(proof, "trackedConn") {
+		tracked.Close(); return nil, nil, E.New("unknown tracked transport")
+	}
+	private := &adapter.PacketSessionOnceConn{Conn: tracked}
+	if err = attach(private.Close); err != nil { private.Close(); return nil, nil, err }
+	if err = ctx.Err(); err != nil { private.Close(); return nil, nil, err }
+	standard := config.(*tls.STDClientConfig)
+	inner, _ := standard.STDConfig()
+	secure := stdtls.Client(private, inner)
+	handshakeCtx := ctx
+	cancel := func() {}
+	if timeout := standard.HandshakeTimeout(); timeout > 0 { handshakeCtx, cancel = context.WithTimeout(ctx, timeout) }
+	err = secure.HandshakeContext(handshakeCtx)
+	cancel()
+	if err != nil { private.Close(); return nil, nil, err }
+	return secure, private.Close, nil
+}
