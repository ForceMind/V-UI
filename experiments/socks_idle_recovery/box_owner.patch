+		options.TLSFragmentFallbackDelay != 0 || options.TLSRecordFragment || options.TLSSpoof != "" || options.TLSSpoofMethod != 0 {
+		return E.New("unsupported packet session route options")
+	}
+	return nil
+}
+
+// This method blocks until both copies, private abort, protocol cache finalizer
+// and callback have completed. The SOCKS owner separately joins its invocation.
+func (m *ConnectionManager) newOwnedPacketConnection(ctx context.Context, outbound N.Dialer, child N.PacketConn, metadata adapter.InboundContext, policy adapter.PacketSessionPolicy, onClose N.CloseHandlerFunc) {
+	completeFailure := func(err error) {
+		if policy.Lifecycle != nil { policy.Lifecycle.BeginPacketSessionRetire(err) }
+		child.Close()
+		if onClose != nil { onClose(err) }
+	}
+	if err := validatePacketSessionMetadata(policy, &metadata); err != nil { completeFailure(err); return }
+	selected, isOutbound := outbound.(adapter.Outbound)
+	if !isOutbound || selected.Tag() != policy.Outbound { completeFailure(E.New("packet session outbound substitution refused")); return }
+	private, ok := outbound.(adapter.OwnedPacketSessionDialer)
+	if !ok { completeFailure(E.New("missing private packet session capability")); return }
+	if err := private.ValidatePacketSession(); err != nil { completeFailure(err); return }
+	admissionCtx, cancelAdmission := context.WithTimeout(adapter.WithContext(ctx, &metadata), 3*time.Second)
+	lease, err := private.OpenPacketSession(admissionCtx, policy.Target, policy.Lifecycle.AttachPacketSessionAbort)
+	if err == nil && !lease.IsValid() { err = N.ErrPacketSessionLifecycle }
+	if err == nil { err = admissionCtx.Err() }
+	if err == nil { err = policy.Lifecycle.PacketSessionAdmitted() }
+	cancelAdmission()
+	if err != nil {
+		policy.Lifecycle.BeginPacketSessionRetire(err)
+		if lease != nil { lease.AbortTransport(); lease.Finalize() }
+		child.Close()
+		if onClose != nil { onClose(err) }
+		return
+	}
+	remote := lease.PacketConn()
+	front, rear := N.CalculateFrontHeadroom(remote), N.CalculateRearHeadroom(remote)
+	if front < 0 || front > 286 || rear < 0 || rear > 96 || N.CalculateFrontHeadroom(child) > 286 || N.CalculateRearHeadroom(child) > 96 {
+		policy.Lifecycle.BeginPacketSessionRetire(N.ErrPacketSessionLifecycle)
+		lease.AbortTransport(); child.Close(); lease.Finalize()
+		if onClose != nil { onClose(N.ErrPacketSessionLifecycle) }
+		return
+	}
+	var once sync.Once
+	var cause error
+	retire := func(err error) {
+		if err == nil { err = N.ErrPacketSessionLifecycle }
+		once.Do(func() {
+			cause = err
+			policy.Lifecycle.BeginPacketSessionRetire(err)
+			lease.AbortTransport()
+			child.Close()
+		})
+	}
+	results := make(chan error, 2)
+	var joined sync.WaitGroup
+	joined.Add(2)
+	go func() {
+		defer joined.Done()
+		_, err := bufio.CopyPacket(&packetSessionWriter{writer: remote, target: policy.Target, front: front, rear: rear, lifecycle: policy.Lifecycle, retire: retire}, &packetSessionReader{reader: child, target: policy.Target, retire: retire})
+		retire(err)
+		results <- err
+	}()
+	go func() {
+		defer joined.Done()
+		_, err := bufio.CopyPacket(&packetSessionWriter{writer: child, target: policy.Target, front: N.CalculateFrontHeadroom(child), rear: N.CalculateRearHeadroom(child), retire: retire}, &packetSessionReader{reader: remote, target: policy.Target, retire: retire})
+		retire(err)
+		results <- err
+	}()
+	// The invocation itself waits on cancellation; no third per-child worker.
+	select {
+	case <-results:
+	case <-ctx.Done():
+		retire(ctx.Err())
+		<-results
+	}
+	<-results
+	joined.Wait()
+	if finalErr := lease.Finalize(); finalErr != nil && !errors.Is(finalErr, net.ErrClosed) && !errors.Is(finalErr, context.Canceled) {
+		cause = finalErr // An uncertain finalizer must never authorize recovery.
+	}
+	if onClose != nil { onClose(cause) }
+}
+
+// Opaque guards prevent CopyPacket from discovering cache, batch, waiter,
+// unwrap or direct-copy methods that could bypass the acknowledgement fence.
+type packetSessionReader struct {
+	reader N.PacketReader
+	target M.Socksaddr
+	retire func(error)
+}
+
+func (r *packetSessionReader) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	destination, err := r.reader.ReadPacket(buffer)
+	if err == nil && (destination != r.target || buffer.Len() > 65497) { err = N.ErrPacketSessionLifecycle }
+	if err != nil { r.retire(err) }
+	return destination, err
+}
+func (*packetSessionReader) ReaderMTU() int { return 65535 }
+func (*packetSessionReader) ReaderOverhead() int { return 0 }
+
+type packetSessionWriter struct {
+	writer N.PacketWriter
+	target M.Socksaddr
+	front int
+	rear int
+	lifecycle N.PacketSessionLifecycle
+	retire func(error)
+}
+
+func (w *packetSessionWriter) FrontHeadroom() int { return w.front }
+func (w *packetSessionWriter) RearHeadroom() int { return w.rear }
+func (w *packetSessionWriter) WritePacket(buffer *buf.Buffer, destination M.Socksaddr) error {
+	// Every successful child ReadPacket is acknowledged exactly once, after the
+	// synchronous write finishes. Pin storage even if the lower writer releases.
+	buffer.IncRef()
+	var err error
+	if destination != w.target || buffer.Len() > 65497 {
+		err = N.ErrPacketSessionLifecycle
+	} else {
+		err = w.writer.WritePacket(buffer, destination)
+	}
+	if err != nil { w.retire(err) }
+	buffer.DecRef()
+	buffer.Release()
+	if w.lifecycle != nil { w.lifecycle.PacketSessionWriteFinished(err) }
+	return err
+}
