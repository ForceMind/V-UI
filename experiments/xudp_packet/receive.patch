diff --git a/common/bufio/packet_complete.go b/common/bufio/packet_complete.go
new file mode 100644
index 0000000..934e2fe
--- /dev/null
+++ b/common/bufio/packet_complete.go
@@ -0,0 +1,24 @@
+package bufio
+
+import (
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// A generic PacketConn has no truncation flags. One bounded probe byte lets us
+// reject oversize reads without rejecting an exact-fit datagram or exposing a
+// successful prefix. A short caller buffer also never receives partial data.
+func readPacketComplete(buffer *buf.Buffer, read func([]byte) (int, M.Socksaddr, error)) (M.Socksaddr, error) {
+	scratch := buf.NewSize(N.MaxPacketSize + 1)
+	defer scratch.Release()
+	n, addr, err := read(scratch.FreeBytes())
+	if err != nil {
+		return M.Socksaddr{}, err
+	}
+	if n < 0 || n > N.MaxPacketSize || n > buffer.FreeLen() {
+		return M.Socksaddr{}, N.ErrPacketTooLarge
+	}
+	_, err = buffer.Write(scratch.FreeBytes()[:n])
+	return addr, err
+}
