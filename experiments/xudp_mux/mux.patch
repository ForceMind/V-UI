--- /dev/null
+++ b/mux_writer.go
@@ -0,0 +1,215 @@
+package vmess
+
+// Isolated experiment. One bounded owner for the shared parent byte stream.
+import (
+    "bytes"
+    "encoding/binary"
+    "io"
+    "net"
+
+    E "github.com/sagernet/sing/common/exceptions"
+    M "github.com/sagernet/sing/common/metadata"
+)
+
+const muxMaxStreams = 64
+const muxMaxPayload = 65535
+const muxMaxFrame = 65807
+
+type muxWrite struct {
+    stream *serverStream
+    frame []byte
+    end bool
+    started bool
+    done chan struct{}
+    err error
+    canceled bool
+    control bool
+}
+
+// All state helpers below require streamAccess. No transport I/O under it.
+func (c *serverSession) changedLocked() {
+    close(c.changed)
+    c.changed = make(chan struct{})
+    select { case c.wake <- struct{}{}: default: }
+}
+func (c *serverSession) finishLocked(op *muxWrite, err error) {
+    op.frame = nil
+    if op.canceled {err=net.ErrClosed}
+    op.err = err
+    close(op.done)
+    s := op.stream
+    if op.control {
+        c.reject=nil
+    } else if op.end {
+        if c.streams[s.id] == s { delete(c.streams, s.id) }
+    } else {
+        s.pending = nil
+        if s.closed && !s.endQueued && c.streams[s.id] == s { delete(c.streams, s.id) }
+    }
+    c.changedLocked()
+}
+func (c *serverSession) newStream(id uint16, network byte, destination M.Socksaddr) (*serverStream, *io.PipeReader, error) {
+    for {
+        c.streamAccess.Lock()
+        if c.closed || c.ctx.Err() != nil { c.streamAccess.Unlock(); return nil,nil,net.ErrClosed }
+        existing := c.streams[id]
+        if existing != nil && !existing.closed { c.streamAccess.Unlock(); return nil,nil,E.New("duplicate active mux session") }
+        if existing == nil && len(c.streams) < muxMaxStreams {
+            reader,writer := io.Pipe()
+            s := &serverStream{id:id,network:network,destination:destination,pipe:writer,done:make(chan struct{}),writeGate:make(chan struct{},1)}
+            c.streams[id]=s
+            c.changedLocked()
+            c.streamAccess.Unlock()
+            return s,reader,nil
+        }
+        if existing==nil {c.streamAccess.Unlock();return nil,nil,nil}
+        changed := c.changed
+        c.streamAccess.Unlock()
+        // Only the single recv loop calls this. Capacity and tombstone pressure
+        // backpressure incoming traffic; they never kill a healthy parent.
+        select { case <-changed: case <-c.ctx.Done(): return nil,nil,net.ErrClosed }
+    }
+}
+// The single recv loop owns one additional fixed rejection slot. It consumes
+// the rejected request payload before waiting for its explicit error-End.
+func (c *serverSession) rejectUnknown(id uint16) *muxWrite {
+    c.streamAccess.Lock()
+    existing:=c.streams[id]
+    c.streamAccess.Unlock()
+    if existing!=nil {return nil}
+    return c.rejectFrame(id)
+}
+func (c *serverSession) rejectFrame(id uint16) *muxWrite {
+    c.streamAccess.Lock();defer c.streamAccess.Unlock()
+    if c.closed {return nil}
+    op:=muxEnd(&serverStream{id:id},true)
+    op.control=true
+    c.reject=op
+    c.queue=append(c.queue,op)
+    c.changedLocked()
+    return op
+}
+func muxEnd(s *serverStream, hasError bool) *muxWrite {
+    option:=byte(0);if hasError {option=OptionError}
+    return &muxWrite{stream:s,frame:[]byte{0,4,byte(s.id>>8),byte(s.id),StatusEnd,option},end:true,done:make(chan struct{})}
+}
+func (c *serverSession) closeStream(s *serverStream, sendEnd bool, err error) {
+    c.streamAccess.Lock()
+    defer c.streamAccess.Unlock()
+    if c.closed || c.streams[s.id]!=s || s.closed {return}
+    s.closed=true
+    if s.pending!=nil {s.pending.canceled=true}
+    close(s.done)
+    if s.pipe!=nil {_=s.pipe.CloseWithError(err)}
+    // Reserve End before withdrawing data; finishLocked must not release the
+    // tombstone before its End has actually completed.
+    s.endQueued=sendEnd
+    if op:=s.pending;op!=nil && !op.started {
+        for i,queued:=range c.queue {if queued==op {
+            copy(c.queue[i:],c.queue[i+1:]);c.queue[len(c.queue)-1]=nil;c.queue=c.queue[:len(c.queue)-1]
+            c.finishLocked(op,net.ErrClosed);break
+        }}
+    }
+    if sendEnd {c.queue=append(c.queue,muxEnd(s,err!=nil))} else if s.pending==nil {delete(c.streams,s.id)}
+    c.changedLocked()
+}
+func (c *serverSession) shutdown(err error) {
+    c.streamAccess.Lock()
+    if c.closed {c.streamAccess.Unlock();return}
+    c.closed=true
+    for _,s:=range c.streams {
+        if s.pending!=nil {s.pending.canceled=true}
+        if !s.closed {s.closed=true;close(s.done)}
+        if s.pipe!=nil {_=s.pipe.CloseWithError(err)}
+    }
+    queued:=c.queue;c.queue=nil
+    for _,op:=range queued {c.finishLocked(op,err)}
+    c.streams=make(map[uint16]*serverStream)
+    c.changedLocked();c.streamAccess.Unlock()
+    // Parent cancellation/failure owns this operation. Association Close never
+    // reaches this path or changes a parent deadline.
+    _=c.conn.Close()
+}
+func (c *serverSession) writeData(s *serverStream, data []byte, destination M.Socksaddr, packet bool) (int,error) {
+    if packet && len(data)>muxMaxPayload {return 0,io.ErrShortBuffer}
+    select {case s.writeGate<-struct{}{}:case <-s.done:return 0,net.ErrClosed;case <-c.ctx.Done():return 0,net.ErrClosed}
+    defer func(){<-s.writeGate}()
+    // TCP's API accepts large writes; split rather than truncate a uint16.
+    total:=0
+    for len(data)>0 || (total==0 && packet) {
+        size:=len(data);if size>muxMaxPayload {size=muxMaxPayload}
+        if err:=c.writeOne(s,data[:size],destination,packet);err!=nil {return total,err}
+        total+=size;data=data[size:]
+        if packet {break}
+    }
+    return total,nil
+}
+func (c *serverSession) writeOne(s *serverStream, data []byte, destination M.Socksaddr, packet bool) error {
+    for {
+        c.streamAccess.Lock()
+        if c.closed || s.closed || c.streams[s.id]!=s || c.ctx.Err()!=nil {c.streamAccess.Unlock();return net.ErrClosed}
+        if s.pending==nil {
+            headerLen:=4
+            if packet {headerLen=5+AddressSerializer.AddrPortLen(destination)}
+            frameLen:=2+headerLen+2+len(data)
+            if frameLen>muxMaxFrame {c.streamAccess.Unlock();return io.ErrShortBuffer}
+            // Admission precedes allocation. Never retain caller-owned bytes.
+            frame:=bytes.NewBuffer(make([]byte,0,frameLen))
+            _=binary.Write(frame,binary.BigEndian,uint16(headerLen))
+            _=binary.Write(frame,binary.BigEndian,s.id)
+            frame.Write([]byte{StatusKeep,OptionData})
+            if packet {
+                frame.WriteByte(NetworkUDP)
+                if err:=AddressSerializer.WriteAddrPort(frame,destination);err!=nil {c.streamAccess.Unlock();return err}
+            }
+            _=binary.Write(frame,binary.BigEndian,uint16(len(data)))
+            frame.Write(data)
+            op:=&muxWrite{stream:s,frame:frame.Bytes(),done:make(chan struct{})}
+            s.pending=op;c.queue=append(c.queue,op)
+            c.changedLocked();c.streamAccess.Unlock()
+            return op.wait(s.done,c.ctx.Done())
+        }
+        changed:=c.changed;c.streamAccess.Unlock()
+        select {case <-changed:case <-s.done:return net.ErrClosed;case <-c.ctx.Done():return net.ErrClosed}
+    }
+}
+func (c *serverSession) writeLoop() {
+    defer close(c.writerDone)
+    for {
+        c.streamAccess.Lock()
+        if c.closed || c.ctx.Err()!=nil {c.streamAccess.Unlock();return}
+        if len(c.queue)==0 {
+            c.streamAccess.Unlock()
+            select {case <-c.wake:case <-c.ctx.Done():return}
+            continue
+        }
+        op:=c.queue[0]
+        copy(c.queue,c.queue[1:]);c.queue[len(c.queue)-1]=nil;c.queue=c.queue[:len(c.queue)-1]
+        op.started=true
+        frame:=op.frame
+        c.streamAccess.Unlock()
+        var err error
+        for len(frame)>0 {
+            var n int
+            n,err=c.conn.Write(frame)
+            if n<0 || n>len(frame) {err=io.ErrShortWrite;n=0}
+            frame=frame[n:]
+            if err!=nil {break}
+            if n==0 {err=io.ErrNoProgress;break}
+        }
+        c.streamAccess.Lock();c.finishLocked(op,err);c.streamAccess.Unlock()
+        if err!=nil {c.cancel(err);return}
+    }
+}
+
+// A completion already linearized under streamAccess wins over a later Close.
+// Conversely finishLocked preserves canceled=true when Close won first.
+func (op *muxWrite) wait(streamDone,parentDone <-chan struct{}) error {
+    select {case <-op.done:return op.err;default:}
+    select {
+    case <-op.done:return op.err
+    case <-streamDone:
+    case <-parentDone:
+    }
+    select {case <-op.done:return op.err;default:return net.ErrClosed}
+}
