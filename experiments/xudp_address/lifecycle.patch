diff --git a/route/conn.go b/route/conn.go
--- a/route/conn.go
+++ b/route/conn.go
@@ -261,10 +261,30 @@
 			udpTimeout = C.ProtocolTimeouts[protocol]
 		}
 	}
+	var watchTimer bool
 	if udpTimeout > 0 {
+		previousTimer, _ := conn.(*canceler.TimerPacketConn)
 		ctx, conn = canceler.NewPacketConn(ctx, conn, udpTimeout)
+		timer, isTimer := conn.(*canceler.TimerPacketConn)
+		watchTimer = metadata.UDPConnect && metadata.UDPTimeout > 0 && isTimer && timer != previousTimer
 	}
 	destination := bufio.NewPacketConn(remotePacketConn)
+	if watchTimer {
+		// Isolated experiment: shared VMess/mux paths are not product-qualified.
+		// Close only the owned outbound; never cancel the inbound mux parent.
+		stop := context.AfterFunc(ctx, func() {
+			_ = remotePacketConn.Close()
+		})
+		originalOnClose := onClose
+		onClose = func(err error) {
+			stop()
+			// Inbound Close may block while writing a mux StatusEnd frame.
+			_ = remotePacketConn.Close()
+			if originalOnClose != nil {
+				originalOnClose(err)
+			}
+		}
+	}
 	var done atomic.Bool
 	go m.packetConnectionCopy(ctx, conn, destination, false, &done, onClose)
 	go m.packetConnectionCopy(ctx, destination, conn, true, &done, onClose)
